# =============================================================================
# RECON-IA API — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# --- BASE DE DONNÉES POSTGRESQL ---
POSTGRES_DB=recondb
POSTGRES_USER=reconuser
POSTGRES_PASSWORD=ChangeMe_DB_Password_Here

# --- REDIS (stockage partagé du rate limiter) ---
# Requis en production : sous gunicorn multi-workers, le stockage mémoire par
# défaut donne un compteur SÉPARÉ par worker, donc une limite effective
# multipliée par le nombre de workers.
# En dev local sans Redis, laisser vide : repli automatique sur memory://
# (un avertissement est journalisé au démarrage).
REDIS_URL=redis://redis:6379/0

# --- EMAIL / SMTP POUR L'ENVOI D'OTP ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre.email@gmail.com
# Pour Gmail : utiliser un "App Password" (pas votre mot de passe habituel)
# https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=votre_app_password_ici
EMAIL_FROM=noreply@votredomaine.com

# --- AUTHENTIFICATION ADMIN ---
# ADMIN_EMAIL : email/identifiant admin utilisé pour HTTP Basic Auth et POST /auth/login
ADMIN_EMAIL=admin@example.com
# ADMIN_DOMAIN : non utilisée par le code actuel, conservée uniquement par
# compatibilité avec une ancienne configuration. Peut être omise.
ADMIN_DOMAIN=
# ADMIN_NOTIFICATION_EMAIL : destinataire des notifications d'erreur internes
# (utils/email_sender.py). Laisser vide utilise un email par défaut codé en
# dur dans le code — à renseigner explicitement en production.
ADMIN_NOTIFICATION_EMAIL=
# ADMIN_PASSWORD : DOIT être un hash werkzeug, jamais le mot de passe en clair !
# Générer avec : python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('VotreMotDePasse'))"
# NE PAS doubler les `$` du hash (garder `$` simple, tel que généré) : même si
# `docker-compose.yml` charge ce fichier via `env_file:` (qui interpole les `$`
# et tronque un `$` simple), `config.py` recharge ensuite ce même fichier en
# Python via `load_dotenv(override=True)` — qui n'interpole PAS les `$` et
# écrase la valeur Docker par le contenu brut du fichier. C'est donc le `$`
# simple, littéral, qui doit être dans ce fichier pour que l'authentification
# fonctionne (voir CLAUDE.md §7 pour le détail).
ADMIN_PASSWORD=pbkdf2:sha256:600000$xxxx...hash généré, $ NON doublés
# ADMIN_PASSWORD_PLAIN et DOMAIN_URL_API ne sont PLUS utilisés (2026-10-19) :
# n8n appelle l'API à son adresse interne avec son propre jeton de service,
# il ne reçoit plus le mot de passe admin.

# --- SECRETS PARTAGÉS AVEC n8n : PAS ICI ---
# PIPELINE_SERVICE_TOKEN, N8N_WEBHOOK_SECRET, N8N_PIPELINE_WEBHOOK_URL,
# RESULTS_ACCESS_SECRET, RESULTS_PAGE_URL et TURNSTILE_SECRET_KEY se
# définissent UNE seule fois dans le `.env` RACINE (générés par setup.sh) :
# docker-compose.yml les injecte dans l'API et, pour les deux premiers, dans
# n8n. Les recopier ici créerait une seconde copie qui finirait par diverger
# (et `config.py` donnerait priorité à celle-ci).

# --- CODE D'ACCÈS AUX RÉSULTATS (utils/result_vault.py) ---
# Durée de validité du code envoyé par mail (décision D2 : 30 jours)
RESULTS_ACCESS_TTL_DAYS=30
# Durée d'une session de consultation ouverte avec le code (secondes)
RESULTS_SESSION_TTL_SECONDS=3600
# Tentatives OTP incorrectes tolérées par dossier avant annulation du code
OTP_MAX_ATTEMPTS=5

# --- CONSERVATION DES DONNÉES (utils/retention.py, purge horaire) ---
# Après expiration/révocation du code : effacement des résultats chiffrés et
# anonymisation du demandeur au bout de N jours
RESULTS_PURGE_GRACE_DAYS=7
# Demandes jamais vérifiées (OTP non validé) supprimées au bout de N jours
UNVERIFIED_RETENTION_DAYS=7
# Journal d'audit (adresses IP) supprimé au bout de N jours
AUDIT_RETENTION_DAYS=90

# --- SECRET KEY FLASK ---
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changez_cette_cle_secrete_en_production

# =============================================================================
# ANALYSE IA — cascade de backends
# Le premier backend dont la clé est configurée est utilisé ; en cas d'échec
# (quota, erreur), le suivant prend le relai. Si aucune clé n'est définie,
# repli automatique sur Ollama local (aucune clé requise, voir docker-compose).
# =============================================================================

# --- DeepSeek (slot 0 — payant, PAS de quota gratuit) --- clé : https://platform.deepseek.com/api_keys
# Placé en tête de cascade uniquement pour test (2026-07-30, voir CLAUDE.md) —
# laisser vide pour ne pas générer de coûts et revenir aux backends gratuits.
# ⚠️ GARDE-FOU : la clé seule ne suffit PAS à activer ce backend — il faut EN
# PLUS DEEPSEEK_CONFIRM_EXTERNAL_SHARING=true pour confirmer explicitement
# l'envoi des données OSINT du scan à ce prestataire tiers payant.
DEEPSEEK_API_KEY=
DEEPSEEK_CONFIRM_EXTERNAL_SHARING=
DEEPSEEK_MODEL=deepseek-chat

# --- Gemini (slot 1 — principal) --- clé gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Cerebras (slot 2) --- clé gratuite : https://cloud.cerebras.ai/platform/apikeys
CEREBRAS_API_KEY=

# --- Groq (slot 3) --- clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=
# Modèle Groq principal (tool use + rapidité)
ANALYSIS_MODEL=llama-3.3-70b-versatile
# Modèles de repli si le modèle principal atteint son quota (séparés par virgule)
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,gemma2-9b-it
# Pause (secondes) avant de réessayer après une erreur de débit (TPM)
GROQ_TPM_SLEEP=15

# --- OpenRouter (slot 4 — dernier recours cloud) --- clé gratuite : https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-235b-a22b:free,mistralai/mistral-7b-instruct:free
OPENROUTER_MAX_ROUNDS=2
OPENROUTER_RATE_LIMIT_SLEEP=12
# Nombre de 429 consécutifs avant de passer au modèle suivant de la file
OPENROUTER_MAX_429_BEFORE_SWITCH=3
# Taille max (caractères) d'un résultat de recherche web renvoyé au modèle
OPENROUTER_MAX_TOOL_RESULT_CHARS=2500

# --- Options communes à tous les backends ---
# Nombre max d'itérations de recherche web par analyse
ANALYSIS_MAX_SEARCH_ROUNDS=4
# Durée de validité du cache d'analyse en heures (défaut : 168h = 7 jours)
ANALYSIS_CACHE_TTL_HOURS=168
# Clé Tavily (optionnelle) pour la recherche web pendant l'analyse — sans
# elle, repli sur DuckDuckGo (gratuit, sans clé)
TAVILY_API_KEY=

# --- RAG (recherche pgvector avant l'analyse, utils/rag_retrieval.py) ---
# Nombre d'extraits du corpus injectés dans le prompt d'analyse
RAG_TOP_K=6
# Délai max (secondes) du calcul d'embedding de la requête via Ollama
RAG_EMBED_TIMEOUT=30

# --- SCAN OSINT (routes/recon.py) ---
# Threads de la vague parallèle (outils I/O-bound : peut dépasser le nb de cœurs)
SCAN_MAX_WORKERS=8
# Budget global (secondes) d'une vague parallèle, tous outils confondus
SCAN_DEADLINE_SECONDS=180

# --- BOUCLE AGENT — pivots choisis par l'IA (phase 8, utils/recon_agent.py) ---
# Désactivée par défaut. Active, elle s'exécute à la fin de POST /pass_recon et
# ajoute `agent_pivots` aux résultats bruts. Il faut un backend capable de
# function calling : GEMINI_API_KEY, ou DEEPSEEK_API_KEY +
# DEEPSEEK_CONFIRM_EXTERNAL_SHARING=true, ou AGENT_OLLAMA_MODEL (≥ 7B). Sans
# backend capable : statut `skipped`, le flux classique continue.
# ⚠️ La boucle allonge /pass_recon d'au plus AGENT_DEADLINE_SECONDS (+ un appel
# LLM / outil en cours) : garder GUNICORN_TIMEOUT et le timeout n8n au-dessus.
AGENT_RECON_ENABLED=false
# auto (gemini → deepseek → ollama) | gemini | deepseek | ollama
AGENT_BACKEND=auto
# Modèles (défaut : GEMINI_MODEL / DEEPSEEK_MODEL des clients d'analyse)
AGENT_GEMINI_MODEL=
AGENT_DEEPSEEK_MODEL=
# Modèle Ollama local DÉDIÉ à la boucle (jamais qwen3:1.7b), ex. qwen2.5:7b
AGENT_OLLAMA_MODEL=
# Taille minimale (milliards de paramètres) lue dans le tag du modèle Ollama
AGENT_OLLAMA_MIN_PARAMS_B=7
# Délai max d'un appel LLM (secondes) — cloud / Ollama
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_OLLAMA_TIMEOUT_SECONDS=180
# Budget dur : pivots exécutés, profondeur, échéance globale (défaut :
# min(SCAN_DEADLINE_SECONDS, 120)), tours de LLM, appels par tour, refus
# cumulés avant arrêt (anti-boucle), délai d'un outil
AGENT_MAX_PIVOTS=15
AGENT_MAX_DEPTH=2
AGENT_DEADLINE_SECONDS=120
AGENT_MAX_ROUNDS=8
AGENT_MAX_CALLS_PER_ROUND=4
AGENT_MAX_REFUSALS=10
AGENT_TOOL_TIMEOUT_SECONDS=30
# Taille max (caractères) du résumé du graphe et d'une sortie d'outil envoyés au LLM
AGENT_SUMMARY_MAX_CHARS=6000
AGENT_TOOL_OUTPUT_CHARS=1500

# --- OTP (vérification de l'email) ---
# Durée de validité du code à 6 chiffres, en secondes
OTP_TTL_SECONDS=600

# --- SERVEUR (gunicorn, lu par entrypoint.sh) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
# Nombre EXACT de reverse proxies devant l'API (ProxyFix). Le surévaluer
# permet d'usurper l'IP cliente via X-Forwarded-For (contourne le rate limit).
TRUSTED_PROXY_COUNT=1

# --- CORS (domaines autorisés, séparés par des virgules) ---
# Laisser vide ou * pour tout autoriser (dev uniquement !)
# En production : CORS_ORIGINS=https://monapp.com,https://admin.monapp.com
CORS_ORIGINS=*

# --- OPTIONS FLASK ---
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
LOG_LEVEL=INFO

# --- BASE DE DONNÉES (chaîne de connexion complète, alternative à
#     POSTGRES_DB/USER/PASSWORD si vous préférez une seule variable) ---
# Exemple : postgresql://user:password@hostname:port/dbname
DATABASE_URL=postgresql://reconuser:ChangeMe_DB_Password_Here@postgres:5432/recondb

# =============================================================================
# CLÉS D'API OPTIONNELLES — OUTILS DE RECONNAISSANCE PASSIVE
# Toutes optionnelles : l'outil concerné se dégrade proprement si la clé est absente.
# =============================================================================

# --- GITHUB_TOKEN (optionnel) ---
# Utilisé par l'outil `github` (github-subdomains).
# Absent → l'outil retourne status "skipped".
# Créer un token « classic » sans scope : https://github.com/settings/tokens
GITHUB_TOKEN=

# --- OTX_API_KEY (optionnel) ---
# Utilisé par l'outil `otx_passive_dns` (AlienVault OTX — historique DNS passif).
# Absent → la requête est tentée en accès anonyme ; si OTX refuse (401/403),
# l'outil retourne status "limited" au lieu de "success".
# Clé gratuite : https://otx.alienvault.com/api
OTX_API_KEY=

# NOTE : HIBP_API_KEY n'est plus utilisé — Have I Been Pwned exige un abonnement
# payant ET une vérification de propriété du domaine (403 systématique sur un
# domaine tiers). Remplacé par l'outil `xposedornot_breaches` (gratuit, sans clé).

# --- ABUSEIPDB_API_KEY (optionnel, gratuit) ---
# Utilisé par l'outil `abuseipdb_check` (réputation des IP résolues, 1000 req/j).
# Absent → l'outil retourne status "skipped" (aucune requête effectuée).
# Clé gratuite (sans CB) : https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# --- ABUSECH_AUTH_KEY (optionnel, gratuit) ---
# Utilisé par l'outil `abusech_check` (URLhaus + ThreatFox — malware/C2 abuse.ch).
# Absent → l'outil retourne status "skipped" (aucune requête effectuée).
# Clé unique pour les deux APIs, gratuite : https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# --- URLSCAN_API_KEY (optionnel, gratuit) ---
# Utilisé par l'outil `urlscan_search` (historique de scans publics passifs).
# Absent → l'outil retourne status "skipped" (aucune requête effectuée).
# Clé gratuite : https://urlscan.io/user/signup
URLSCAN_API_KEY=

# =============================================================================
# PHASE 5 — COLLECTE PASSIVE ENRICHIE (routes/recon.py, utils/passive_sources/)
# Toutes optionnelles : l'outil concerné se dégrade proprement si la clé manque.
# =============================================================================

# --- VIRUSTOTAL_API_KEY (optionnel, gratuit) ---
# Utilisé par l'outil `virustotal` (réputation domaine/IP + passive DNS).
# Absent → l'outil retourne status "skipped". Free tier : 4 requêtes/min.
# Clé gratuite : https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# --- GOOGLE_SAFE_BROWSING_API_KEY (optionnel, gratuit) ---
# Utilisé par l'outil `threats_check` (volet Google Safe Browsing). Sans elle,
# seul PhishTank est interrogé (qui, lui, ne nécessite pas de clé).
# Clé gratuite : https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# --- PHISHTANK_API_KEY (optionnel) ---
# Améliore le quota de l'outil `threats_check` (volet PhishTank). PhishTank
# fonctionne sans clé ; cette variable n'est qu'un bonus de quota.
# Inscription : https://phishtank.org/developer_info.php
PHISHTANK_API_KEY=

# --- DNSDUMPSTER_API_KEY (optionnel, gratuit) ---
# Utilisé par l'outil `dnsdumpster` (cartographie DNS passive, API officielle).
# Absent → l'outil retourne status "skipped".
# Clé gratuite : https://dnsdumpster.com/ (compte → API)
DNSDUMPSTER_API_KEY=

# --- GRAYHATWARFARE_API_KEY (optionnel, priorité basse) ---
# Utilisé par l'outil `grayhatwarfare` (fichiers exposés dans des buckets cloud).
# Absent → l'outil retourne status "skipped".
# Clé : https://grayhatwarfare.com/ (free tier limité)
GRAYHATWARFARE_API_KEY=

# NOTE : l'outil `github_dorks` (recherche de secrets dans le code public)
# réutilise GITHUB_TOKEN ci-dessus. Les valeurs de secrets ne sont JAMAIS
# stockées (seuls l'emplacement, le type et un fragment masqué le sont).

# --- BORNES DE LA RÉSOLUTION DNS MASSIVE (outil `dns_mass`, B4) ---
# Nombre maximal de sous-domaines résolus (priorisés), threads, budget temps (s)
# et nombre maximal de recherches ASN (= plafond d'IP uniques traitées).
DNS_MASS_MAX_SUBDOMAINS=300
DNS_MASS_WORKERS=10
DNS_MASS_BUDGET_SECONDS=60
SHODAN_IDB_MAX_IPS=50

# ============================================================
# FIABILITÉ DE L'ANALYSE (phase 3 — voir docs/phases/PHASE_3.md)
# ============================================================
# Catalogue CISA KEV : une CVE observée qui y figure passe en CRITICAL.
# Téléchargé au plus une fois par KEV_REFRESH_HOURS ; indisponible → analyse sans KEV.
KEV_ENABLED=true
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
KEV_CACHE_PATH=
KEV_REFRESH_HOURS=24
KEV_RETRY_MINUTES=60
KEV_TIMEOUT_S=20
KEV_CHECK_INTERVAL_S=3600
# Sévérité déterministe : le LLM propose, la table de règles tranche.
EPSS_HIGH_THRESHOLD=0.1
# Plafond d'un finding qu'aucune règle ne reconnaît.
SEVERITY_UNMATCHED_CAP=MEDIUM
# Constat ≥ ce niveau oublié par le modèle → ajouté par la règle (NONE = désactivé).
SEVERITY_INJECT_MIN=HIGH
# RAG : une requête par constat/finding, filtrée par collection.
RAG_SNIPPETS_PER_QUERY=2
RAG_MAX_QUERIES=8
RAG_MAX_FINDING_QUERIES=10

# ============================================================
# SURVEILLANCE / RESCAN (phase 7 — voir docs/phases/PHASE_7.md)
# ============================================================
# Destinataire des alertes de changement (à défaut ADMIN_NOTIFICATION_EMAIL).
# Jamais le demandeur.
MONITORING_ALERT_EMAIL=
# Rescans traités au plus par passage du cron n8n (workflow recon-ia-rescan, inactif par défaut).
MONITORING_MAX_PER_RUN=5
